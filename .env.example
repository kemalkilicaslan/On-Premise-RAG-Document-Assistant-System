# --- PostgreSQL ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_dev_password
POSTGRES_DB=rag

# --- Ollama ---
# Mac: Ollama runs natively (Metal GPU), the API container reaches it through the host
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Linux server with the "ollama" profile: OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=qwen2.5:7b-instruct
EMBED_MODEL=bge-m3
EMBED_DIM=1024

# --- Auth ---
# Generate with: openssl rand -hex 32  (at least 32 characters)
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
# At least 8 characters
ADMIN_PASSWORD=

# --- Retrieval ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
